<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Career Mode Manager · FC26</title>

    <%= favicon_tag %>
    <%= stylesheet_tag "app" %>
  </head>

  <body>
    <header class="app-header">
      <div class="brand">
        <span class="logo">⚽</span>
        <div>
          <h1>Career Mode Manager</h1>
          <p class="sub">FC26 · plantilla y formación</p>
        </div>
      </div>

      <nav class="tabs">
        <button class="tab is-active" type="button">Plantilla</button>
        <button class="tab" type="button">Formación</button>
        <button class="tab" type="button">Comparar</button>
      </nav>

      <div>
        <p>
          Club: <%= club_name %>
        </p>
      </div>
    </header>

    <%= yield %>

    <%= javascript_tag "app" %>
  </body>
</html>
