<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Career Mode Manager · FC26</title>

    <%= favicon_tag %>
    <%= stylesheet_tag "app" %>
  </head>

  <body>
    <header class="app-header">
      <div class="brand">
        <span class="logo">⚽</span>
        <div>
          <h1>Career Mode Manager</h1>
          <p class="sub">FC26 · plantilla y formación</p>
        </div>
      </div>

      <nav class="tabs">
        <a href="<%= routes.path(:squad) %>"
           class="<%= tab_class(:squad) %>"
        >
          Plantilla
        </a>

        <a href="<%= routes.path(:formation) %>"
           class="<%= tab_class(:formation) %>"
        >
          Formación
        </a>

        <a href="<%= routes.path(:compare) %>"
           class="<%= tab_class(:compare) %>"
        >
          Comparar
        </a>
      </nav>

      <p class="club-name">
        <span class="club-label">Club:</span>
        <%= club_name %>
      </p>
    </header>

    <%= yield %>

    <%= javascript_tag "app" %>
  </body>
</html>
