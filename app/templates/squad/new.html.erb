<main>
  <section class="form-page">
    <div class="form-head">
      <h1>Nuevo jugador</h1>
      <a href="<%= routes.path(:squad) %>" class="btn ghost sm">← Volver</a>
    </div>

    <div class="form-panel">
      <%= render "squad/form",
            action: routes.path(:squad),
            form_method: :post,
            values: {name: "", age: 20, position: "MC", role: "Esporadico", overall: 65, height: 180, foot: "derecho", comment: ""},
            cancel_path: routes.path(:squad),
            submit_label: "Guardar" %>
    </div>
  </section>
</main>
