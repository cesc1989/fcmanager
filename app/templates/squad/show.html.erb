<main>
  <section class="player-page">
    <div class="form-head">
      <h1><%= player.name %></h1>
      <div class="row-actions">
        <a href="<%= routes.path(:squad) %>" class="btn ghost sm">← Volver</a>
        <a href="<%= routes.path(:edit_squad, id: player.id) %>" class="btn primary sm">Editar</a>
      </div>
    </div>

    <% position = position_info(player.primary_position) %>
    <% traits = player.player_traits.sort_by { |pt| [-pt.value.to_i, pt.trait.name] } %>

    <div class="card">
      <div class="card-top">
        <div class="ovr-big <%= rating_class(player.overall) %>">
          <span class="ovr-value"><%= player.overall %></span>
          <span class="ovr-label">PROM</span>
        </div>

        <div class="card-meta">
          <div class="card-line">
            <span class="pos-tag pos-<%= position[:group] %>" title="<%= position[:label] %>"><%= position[:short] %></span>
            <span class="muted"><%= position[:label] %></span>
          </div>
          <div class="card-line"><%= player.age %> años · <%= role_label(player.role) %></div>
          <div class="card-line muted"><%= player.height %> · Pie <%= foot_label(player.dominant_foot).downcase %></div>
        </div>
      </div>

      <h4 class="card-subtitle">Características</h4>
      <% if traits.empty? %>
        <p class="muted">Sin características cargadas.</p>
      <% else %>
        <div class="bars">
          <% traits.each do |pt| %>
            <div class="bar-row">
              <span class="bar-label"><%= pt.trait.name %></span>
              <span class="bar-track"><span class="bar-fill <%= rating_class(pt.value) %>" style="width: <%= [pt.value.to_i, 4].max %>%"></span></span>
              <span class="bar-value"><%= pt.value %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <h4 class="card-subtitle">Comentario</h4>
      <p class="card-comment"><%= player.comment.to_s.empty? ? "Sin comentarios todavía." : player.comment %></p>
    </div>
  </section>
</main>
