<% errors = request.params.errors %>
<% if errors.any? %>
  <div class="error-summary">
    <p class="error">Revisa los siguientes campos:</p>
    <ul>
      <% error_messages(errors).each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for("player", action, values: {player: values}, method: form_method) do |f| %>
  <div class="form-fields">
    <label class="field">
      <span class="field-label">Nombre</span>
      <%= f.text_field "name", class: "input", required: true, autofocus: true %>
      <% field_errors(errors, :player, :name).each do |message| %>
        <p class="error"><%= message %></p>
      <% end %>
    </label>

    <label class="field">
      <span class="field-label">Edad</span>
      <%= f.number_field "age", class: "input", min: 15, max: 45 %>
      <% field_errors(errors, :player, :age).each do |message| %>
        <p class="error"><%= message %></p>
      <% end %>
    </label>

    <label class="field">
      <span class="field-label">Posición</span>
      <%= f.select "position", position_options, class: "input" %>
      <% field_errors(errors, :player, :position).each do |message| %>
        <p class="error"><%= message %></p>
      <% end %>
    </label>

    <label class="field">
      <span class="field-label">Rol</span>
      <%= f.select "role", role_options, class: "input" %>
      <% field_errors(errors, :player, :role).each do |message| %>
        <p class="error"><%= message %></p>
      <% end %>
    </label>

    <label class="field">
      <span class="field-label">Promedio</span>
      <%= f.number_field "overall", class: "input", min: 1, max: 99 %>
      <% field_errors(errors, :player, :overall).each do |message| %>
        <p class="error"><%= message %></p>
      <% end %>
    </label>

    <label class="field">
      <span class="field-label">Altura</span>
      <%= f.number_field "height", class: "input", min: 150, max: 210 %>
      <% field_errors(errors, :player, :height).each do |message| %>
        <p class="error"><%= message %></p>
      <% end %>
    </label>

    <label class="field">
      <span class="field-label">Pie dominante</span>
      <%= f.select "foot", foot_options, class: "input" %>
      <% field_errors(errors, :player, :foot).each do |message| %>
        <p class="error"><%= message %></p>
      <% end %>
    </label>
  </div>

  <h4 class="card-subtitle">Características</h4>
  <div class="traits">
    <% grouped_traits(traits).each do |group| %>
      <section class="trait-group">
        <h5 class="trait-group-title"><%= group[:label] %></h5>

        <div class="trait-grid">
          <% group[:traits].each do |trait| %>
            <label class="field">
              <span class="field-label"><%= trait.name %></span>
              <%= f.number_field "traits.#{trait.id}",
                    name: "player[traits][#{trait.id}]",
                    id: "player-traits-#{trait.id}",
                    value: trait_value(trait.id, values),
                    class: "input", min: 1, max: 99 %>
            </label>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <label class="field">
    <span class="field-label">Comentario</span>
    <%= f.text_area "comment", class: "input textarea", rows: 3 %>
    <% field_errors(errors, :player, :comment).each do |message| %>
      <p class="error"><%= message %></p>
    <% end %>
  </label>

  <div class="form-actions">
    <a href="<%= cancel_path %>" class="btn ghost">Cancelar</a>
    <%= f.submit submit_label, class: "btn primary" %>
  </div>
<% end %>
