<main>
  <section class="view">
    <div class="toolbar">
      <input id="search" class="input" type="search" placeholder="Buscar por nombre o comentario…">
      <select id="filter-group" class="input">
        <option value="ALL">Todas las líneas</option>
        <option value="POR">Porteros</option>
        <option value="DEF">Defensas</option>
        <option value="MED">Mediocampistas</option>
        <option value="DEL">Delanteros</option>
      </select>
      <select id="sort-by" class="input">
        <option value="position">Ordenar: posición</option>
        <option value="overall">Ordenar: promedio</option>
        <option value="age">Ordenar: edad</option>
        <option value="name">Ordenar: nombre</option>
      </select>
      <span class="spacer"></span>
      <span id="squad-count" class="muted">8 de 8 jugadores</span>
      <button id="btn-new" class="btn primary" type="button">+ Nuevo jugador</button>
    </div>

    <div class="table-wrap">
      <table class="squad-table">
        <thead>
          <tr>
            <th class="col-name">Nombre</th>
            <th class="col-num">Edad</th>
            <th>Posición</th>
            <th>Rol</th>
            <th class="col-num">Prom.</th>
            <th class="col-attrs">Características</th>
            <th class="col-comment">Comentario</th>
            <th class="col-actions"></th>
          </tr>
        </thead>
        <tbody id="squad-body">
          <tr>
            <td class="col-name">
              <button class="link-name" type="button">Iker Salas</button>
              <span class="badge-xi">XI</span>
            </td>
            <td class="col-num">27</td>
            <td><span class="pos-tag pos-POR" title="Portero">POR</span></td>
            <td>Esencial</td>
            <td class="col-num"><span class="ovr is-elite">82</span></td>
            <td class="col-attrs">
              <div class="chips">
                <span class="chip attr <%= rating_class(85) %>" title="Reflejos"><span class="attr-short">REF</span><span class="attr-value">85</span></span>
                <span class="chip attr <%= rating_class(83) %>" title="Colocación"><span class="attr-short">COL</span><span class="attr-value">83</span></span>
                <span class="chip attr <%= rating_class(79) %>" title="Manejo"><span class="attr-short">MAN</span><span class="attr-value">79</span></span>
                <span class="chip attr <%= rating_class(74) %>" title="Saque"><span class="attr-short">SAQ</span><span class="attr-value">74</span></span>
                <span class="chip attr <%= rating_class(80) %>" title="Juego aéreo"><span class="attr-short">AER</span><span class="attr-value">80</span></span>
                <span class="chip attr <%= rating_class(84) %>" title="Reacción"><span class="attr-short">REA</span><span class="attr-value">84</span></span>
              </div>
            </td>
            <td class="col-comment"><span class="comment">Seguro bajo palos, pero le cuesta con los pies. Renovar hasta 2029.</span></td>
            <td class="col-actions">
              <button class="icon-btn" type="button" title="Editar">✎</button>
              <button class="icon-btn danger" type="button" title="Eliminar">🗑</button>
            </td>
          </tr>

          <tr>
