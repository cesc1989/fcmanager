<main>
  <section class="view">
    <div class="toolbar">
      <span class="spacer"></span>
      <span id="squad-count" class="muted"><%= players.size %> jugadores</span>

      <a href="<%= routes.path(:new_squad) %>" class="btn primary">+ Nuevo jugador</a>
    </div>

    <div class="table-wrap">
      <table class="squad-table">
        <thead>
          <tr>
            <th class="col-name">Nombre</th>
            <th class="col-num">Edad</th>
            <th>Posición</th>
            <th>Rol</th>
            <th class="col-num">Prom.</th>
            <th class="col-attrs">Características</th>
            <th class="col-comment">Comentario</th>
            <th class="col-actions"></th>
          </tr>
        </thead>
        <tbody id="squad-body">
          <% players.each do |player| %>
            <% position = position_info(player.primary_position) %>
            <% traits = player.player_traits.sort_by { |pt| -pt.value }.take(QTY_OF_TRAITS_TO_SHOW) %>

            <tr>
              <td class="col-name">
                <a href="<%= routes.path(:squad_player, id: player.id) %>" class="link-name"><%= player.name %></a>
              </td>

              <td class="col-num"><%= player.age %></td>

              <td>
                <span class="pos-tag pos-<%= position[:group] %>" title="<%= position[:label] %>">
                  <%= position[:short] %>
                </span>
              </td>

              <td><%= role_label(player.role) %></td>

              <td class="col-num">
                <span class="ovr <%= rating_class(player.overall) %>">
                  <%= player.overall %>
                </span>
              </td>

              <td class="col-attrs">
                <% if traits.empty? %>
                  <span class="muted">—</span>
                <% else %>
                  <div class="chips">
                    <% traits.each do |pt| %>
                      <span class="chip attr <%= rating_class(pt.value) %>" title="<%= pt.trait.name %>">
                        <span class="attr-short">
                          <%= trait_short(pt.trait.name) %>
                        </span>
                        <span class="attr-value"><%= pt.value %></span>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </td>

              <td class="col-comment">
                <span class="comment">
                  <%= player.comment.to_s.empty? ? "—" : player.comment %>
                </span>
              </td>

              <td class="col-actions">
                <a href="<%= routes.path(:edit_squad, id: player.id) %>" class="icon-btn" title="Editar">✎</a>
                <button
                  class="icon-btn danger js-release"
                  type="button"
                  title="Liberar"
                  data-url="<%= routes.path(:release_squad, id: player.id) %>"
                  data-name="<%= player.name %>"
                >🚪</button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if players.empty? %>
        <p id="squad-empty" class="empty">No hay jugadores todavía.</p>
      <% end %>
    </div>
  </section>

  <dialog id="release-dialog" class="dialog">
    <form method="post" action="">
      <input type="hidden" name="_method" value="patch">

      <p>¿Pasar a <strong class="js-release-name"></strong> a Agente Libre?</p>

      <div class="dialog-actions">
        <button class="btn ghost" type="submit" formmethod="dialog" formnovalidate>Cancelar</button>
        <button class="btn danger" type="submit">Liberar</button>
      </div>
    </form>
  </dialog>
</main>
