<main>
  <section class="view">
    <div class="toolbar">
      <span class="spacer"></span>
      <span id="squad-count" class="muted"><%= players.size %> jugadores</span>
      <button id="btn-new" class="btn primary" type="button">+ Nuevo jugador</button>
    </div>

    <div class="table-wrap">
      <table class="squad-table">
        <thead>
          <tr>
            <th class="col-name">Nombre</th>
            <th class="col-num">Edad</th>
            <th>Posición</th>
            <th>Rol</th>
            <th class="col-num">Prom.</th>
            <th class="col-attrs">Características</th>
            <th class="col-comment">Comentario</th>
            <th class="col-actions"></th>
          </tr>
        </thead>
        <tbody id="squad-body">
          <% players.each do |player| %>
            <% position = position_info(player.primary_position) %>
            <% traits = player.player_traits.sort_by { |pt| -pt.value.to_i } %>
            <tr>
              <td class="col-name">
                <button class="link-name" type="button"><%= player.name %></button>
              </td>
              <td class="col-num"><%= player.age %></td>
              <td><span class="pos-tag pos-<%= position[:group] %>" title="<%= position[:label] %>"><%= position[:short] %></span></td>
              <td><%= role_label(player.role) %></td>
              <td class="col-num"><span class="ovr <%= rating_class(player.overall) %>"><%= player.overall %></span></td>
              <td class="col-attrs">
                <% if traits.empty? %>
                  <span class="muted">—</span>
                <% else %>
                  <div class="chips">
                    <% traits.each do |pt| %>
                      <span class="chip attr <%= rating_class(pt.value) %>" title="<%= pt.trait.name %>"><span class="attr-short"><%= trait_short(pt.trait.name) %></span><span class="attr-value"><%= pt.value %></span></span>
                    <% end %>
                  </div>
                <% end %>
              </td>
              <td class="col-comment"><span class="comment"><%= player.comment.to_s.empty? ? "—" : player.comment %></span></td>
              <td class="col-actions">
                <button class="icon-btn" type="button" title="Editar">✎</button>
                <button class="icon-btn danger" type="button" title="Eliminar">🗑</button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if players.empty? %>
        <p id="squad-empty" class="empty">No hay jugadores todavía.</p>
      <% end %>
    </div>
  </section>

  <dialog id="player-modal" class="modal" aria-labelledby="player-modal-title">
    <header class="modal-head">
      <div class="modal-titles">
        <h3 id="player-modal-title">Nuevo jugador</h3>
        <p class="muted">Añade un jugador a la plantilla.</p>
      </div>
      <button type="button" class="icon-btn" data-close title="Cerrar">×</button>
    </header>

    <form id="player-form" class="modal-form" method="post" action="/squad">
      <div class="modal-body">
        <div class="grid-2">
          <label class="field">
            <span class="field-label">Nombre</span>
            <input class="input" type="text" name="name" required placeholder="Nombre del jugador">
          </label>
          <label class="field">
            <span class="field-label">Edad</span>
            <input class="input" type="number" name="age" min="15" max="45" value="20">
          </label>
          <label class="field">
            <span class="field-label">Posición</span>
            <select class="input" name="position">
              <option value="POR">POR · Portero</option>
              <option value="LI">LI · Lateral izquierdo</option>
              <option value="DFC">DFC · Defensa central</option>
              <option value="LD">LD · Lateral derecho</option>
              <option value="MCD">MCD · Mediocentro defensivo</option>
              <option value="MI">MI · Interior izquierdo</option>
              <option value="MC" selected>MC · Mediocentro</option>
              <option value="MD">MD · Interior derecho</option>
              <option value="DC">DC · Delantero centro</option>
            </select>
          </label>
          <label class="field">
            <span class="field-label">Rol</span>
            <select class="input" name="role">
              <option value="Promesa">Promesa</option>
              <option value="Esporadico" selected>Esporadico</option>
              <option value="Rotacion">Rotacion</option>
              <option value="Importante">Importante</option>
              <option value="Esencial">Esencial</option>
            </select>
          </label>
          <label class="field">
            <span class="field-label">Promedio</span>
            <input class="input" type="number" name="overall" min="1" max="99" value="65">
          </label>
          <label class="field">
            <span class="field-label">Altura</span>
            <input class="input" type="number" name="height" min="150" max="210" value="180">
          </label>
          <label class="field">
            <span class="field-label">Pie dominante</span>
            <select class="input" name="foot">
              <option value="derecho" selected>Derecho</option>
              <option value="izquierdo">Izquierdo</option>
            </select>
          </label>
        </div>

        <label class="field">
          <span class="field-label">Comentario</span>
          <textarea class="input textarea" name="comment" rows="3" placeholder="Notas: rol en el equipo, contrato, evolución…"></textarea>
        </label>
      </div>

      <footer class="modal-foot">
        <button type="button" class="btn ghost" data-close>Cancelar</button>
        <button type="submit" class="btn primary">Guardar</button>
      </footer>
    </form>
  </dialog>
</main>
