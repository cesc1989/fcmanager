<%# Lista lateral de jugadores agrupada por línea (Comparar y Formación).
    Locals: players, selected_id, href y badge. `href` y `badge` son lambdas
    que reciben al jugador; `badge` devuelve el texto de la insignia o nil, y
    si hay insignia el jugador sale atenuado. %>
<% if players.empty? %>
  <p class="empty">
    Añade jugadores desde la pestaña Plantilla.
  </p>
<% end %>

<% grouped_squad(players).each do |group| %>
  <div class="bench-group">
    <%= group[:label] %>

    <span class="muted">
      <%= group[:players].size %>
    </span>
  </div>

  <% group[:players].each do |player| %>
    <% position = position_info(player.primary_position) %>
    <% mark = badge.call(player) %>
    <% classes = ["bench-item", ("is-on-pitch" if mark), ("is-selected" if player.id == selected_id)].compact.join(" ") %>

    <a href="<%= href.call(player) %>"
       class="<%= classes %>"
       draggable="true"
       data-player-id="<%= player.id %>"
    >
      <span class="pos-tag pos-<%= position[:group] %>"
            title="<%= position[:label] %>"
      >
        <%= position[:short] %>
      </span>

      <span class="bench-info">
        <span class="bench-name">
          <%= player.name %>
        </span>

        <span class="bench-sub">
          <%= player.age %> años · <%= role_label(player.role) %>
        </span>
      </span>

      <% if mark %>
        <span class="badge-xi">
          <%= mark %>
        </span>
      <% end %>

      <span class="ovr <%= rating_class(player.overall) %>">
        <%= player.overall %>
      </span>
    </a>
  <% end %>
<% end %>
